<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_info_24"
                android:tint="@color/colorPrimary"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ECU modülleri hakkında"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#212121"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginBottom="16dp"/>

        <!-- What are ECUs Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ECU modülü nedir?"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#424242"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ECU’lar motor, şanzıman ve airbag gibi sistemleri yöneten araç bilgisayarlarıdır. Desteklenen kalibrasyon ve yazılım bilgileri görüntülenebilir."
            android:textSize="14sp"
            android:textColor="#616161"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="16dp"/>

        <!-- How to Use Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nasıl kullanılır"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#424242"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="• ECU tara: Modülleri bulun\n\n• Ayrıntı: Bir ECU’ya dokunun\n\n• Karşılaştır: Referans kaydedip sonra karşılaştırın\n\n• Dışa aktar: CSV veya JSON kaydedin\n\n• İçe aktar: Eski taramaları yükleyin"
            android:textSize="14sp"
            android:textColor="#616161"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="16dp"/>

        <!-- Why it Matters Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Neden önemli"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#424242"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kalibrasyon takibi şunlara yardım eder:\n\n• İzinsiz değişiklikleri fark etmek\n• Servis yazılım güncellemelerini izlemek\n• Onarım sonrası doğrulama\n• Servis kaydı tutmak"
            android:textSize="14sp"
            android:textColor="#616161"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="24dp"/>

        <!-- Close Button -->
        <Button
            android:id="@+id/btn_close"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Anladım"
            android:textColor="@android:color/white"
            android:background="@color/colorPrimary"
            android:textStyle="bold"/>

    </LinearLayout>

</ScrollView>

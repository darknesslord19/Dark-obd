<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_info_24"
                android:tint="@color/colorPrimary"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ECU karşılaştırma hakkında"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#212121"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginBottom="16dp"/>

        <!-- What is it Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ECU karşılaştırma nedir?"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#424242"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kayıtlı referans ile mevcut kalibrasyonu karşılaştırır. Yazılım değişikliklerini fark etmeye yardım eder."
            android:textSize="14sp"
            android:textColor="#616161"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="16dp"/>

        <!-- How to Use Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nasıl kullanılır"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#424242"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="• Kayıtlı bir referans seçin\n\n• Karşılaştırma otomatik yapılır\n\n• Özeti inceleyin\n\n• Ayrıntı için ECU’ya dokunun\n\n• Sonucu CSV veya JSON kaydedin"
            android:textSize="14sp"
            android:textColor="#616161"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="16dp"/>

        <!-- Understanding Results Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sonuçları anlama"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#424242"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="• Değişti (turuncu): Cal ID veya CVN farklı\n\n• Değişmedi (yeşil): Referansla aynı\n\n• Cal ID: Kalibrasyon kimliği\n\n• CVN: Kalibrasyon sağlama numarası"
            android:textSize="14sp"
            android:textColor="#616161"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="24dp"/>

        <!-- Close Button -->
        <Button
            android:id="@+id/btn_close"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Anladım"
            android:textColor="@android:color/white"
            android:background="@color/colorPrimary"
            android:textStyle="bold"/>

    </LinearLayout>

</ScrollView>

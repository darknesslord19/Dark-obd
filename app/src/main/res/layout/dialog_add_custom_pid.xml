<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Zorunlu alanlar"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/et_pid_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ad (ör. Turbo basıncı)"
            android:inputType="textCapWords" />

        <EditText
            android:id="@+id/et_pid_hex"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="PID Hex (ör. 221634)"
            android:inputType="textNoSuggestions"
            android:digits="0123456789ABCDEFabcdef" />

        <EditText
            android:id="@+id/et_formula"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Formül (ör. (A*256+B)/10)"
            android:inputType="textNoSuggestions" />

        <EditText
            android:id="@+id/et_units"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Birim (ör. kPa, °C, PSI)"
            android:inputType="text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Araca özel (isteğe bağlı)"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/et_make"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Marka (ör. Nissan), genel için boş bırakın"
            android:inputType="textCapWords" />

        <EditText
            android:id="@+id/et_model"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Model (isteğe bağlı)"
            android:inputType="textCapWords" />

        <EditText
            android:id="@+id/et_years"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Yıllar (isteğe bağlı)"
            android:inputType="text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ek bilgi"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/et_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Açıklama (isteğe bağlı)"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:gravity="top" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Değişkenler:\nA, B, C, D = OBD yanıt baytları\nİşlemler: +, -, *, /, ^, (), min(), max(), abs()"
            android:textSize="11sp"
            android:textColor="@android:color/darker_gray"
            android:layout_marginTop="8dp" />

    </LinearLayout>

</ScrollView>
